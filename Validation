import React, { Component } from 'react';

class UserProfile extends Component {
  constructor(props) {
    super(props);
    this.state = {
      name: props.name || '',
      age: props.age || '',
      isAdmin: props.isAdmin || false,
    };
  }

  handleSubmit = (e) => {
    e.preventDefault();
    const { name, age, isAdmin } = this.state;
    let valid = true;
    if (typeof name !== 'string' || name.trim() === '') {
      console.warn('Invalid: "name" expected a non-empty string.');
      valid = false;
    }
    if (age.toString().trim() === '' || isNaN(Number(age))) {
      console.warn(`Invalid: "age" expected number, got "${age}".`);
      valid = false;
    }
    if (valid) {
      console.log('Submitted:', { name, age: Number(age), isAdmin });
    }
  };

  render() {
    const { name, age, isAdmin } = this.state;

    return (
      <div>
        <h2>{this.props.title || 'User Profile'}</h2>
        <p><strong>Name:</strong> {this.props.name}</p>
        <p><strong>Age:</strong> {this.props.age}</p>
        <form onSubmit={this.handleSubmit}>
          <input type="text" placeholder="Name" value={name} onChange={(e) => this.setState({ name: e.target.value })} /><br />
          <input type="text" placeholder="Age" value={age} onChange={(e) => this.setState({ age: e.target.value })} /><br />
          <label><input type="checkbox" checked={isAdmin} onChange={(e) => this.setState({ isAdmin: e.target.checked })} /> Admin</label><br />
          <button type="submit">Submit</button>
        </form>
      </div>
    );
  }
}

export default UserProfile;
