.calculator {
  width: 250px;
  margin: 50px auto;
  text-align: center;
  border: 2px solid black;
  padding: 10px;
  border-radius: 10px;
  background-color: #f5f5f5;
}

input {
  width: 100%;
  height: 40px;
  font-size: 18px;
  margin-bottom: 10px;
  text-align: right;
  padding: 5px;
}

.buttons {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 5px;
}

button {
  padding: 10px;
  font-size: 16px;
  cursor: pointer;
  border-radius: 5px;
}

.clear {
  grid-column: span 4;
  background-color: red;
  color: white;
}
