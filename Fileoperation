var fs=require('fs')

fs.writeFile('demo.txt','Hello Swanandi You are learning file system!',(err)=>{
    if(err) throw err;
    console.log("File created successfully!");
});

fs.readFile("demo.txt","utf8",(err,data)=>{
    if(err) throw err;
    console.log("File Content:",data);
});

fs.appendFile("demo.txt","\n Welcome to Node.js",(err)=>{
    if(err) throw err;
    console.log("Data Appended");
});

const del=fs.unlink("demo.txt",(err) => {
    if (err) throw err;
    console.log("Deleted File.");
});
